{
  "name": "enterprise-data-mobile",
  "version": "1.0.0-test",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:android:production": "APP_ENV=production EXPO_PUBLIC_APP_ENV=production EXPO_PUBLIC_API_BASE_URL=https://atlasfieldops.com/api/v1 EXPO_PUBLIC_APP_VERSION=1.0.0-test expo prebuild --platform android",
    "android:apk:release": "cd android && ./gradlew assembleRelease",
    "android:aab:release": "cd android && ./gradlew bundleRelease",
    "android:build:release": "npm run prebuild:android:production && npm run android:apk:release && npm run android:aab:release",
    "eas:apk:production": "eas build --platform android --profile production-apk",
    "eas:aab:production": "eas build --platform android --profile production",
    "typecheck": "tsc --noEmit -p tsconfig.core.json",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-community/datetimepicker": "8.0.1",
    "expo": "^51.0.0",
    "expo-av": "~14.0.7",
    "expo-camera": "~15.0.16",
    "expo-constants": "~16.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-image-picker": "~15.0.7",
    "expo-linking": "~6.3.1",
    "expo-local-authentication": "~14.0.1",
    "expo-location": "~17.0.1",
    "expo-router": "^3.5.0",
    "expo-secure-store": "^13.0.2",
    "expo-splash-screen": "~0.27.7",
    "expo-sqlite": "^14.0.0",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "leaflet": "^1.9.4",
    "lucide-react-native": "^1.17.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-signature-canvas": "^5.0.2",
    "react-native-svg": "15.2.0",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "jest": "^29.7.0",
    "typescript": "^5.4.5"
  }
}
